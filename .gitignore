# Gitignore file

# Ignore all content in the projects folder
3dgs-pipeline-app/projects/*

# Allow the projects folder itself
!3dgs-pipeline-app/projects/
# --- Added for BETA002 -------------------------------------------------------
# Heavy artefacts that must never reach GitHub. Some files under these paths
# were committed before this rule and stay tracked; the rule stops NEW ones.

# Python virtualenv
3dgs-pipeline-app/.venv/

# Python bytecode
__pycache__/
*.pyc

# Node dependencies + Vite pre-bundle cache.
# Unanchored: there are two — frontend/ and one at the repo root for shadcn-ui.
node_modules/

# LichtFeld Studio writes imgui.ini into its working directory: local UI state.
imgui.ini

# Vendored external binaries (LichtFeld Studio, RealityScan, FFmpeg...).
# LichtFeld ships a 105 MB slang-llvm.dll — over GitHub's hard 100 MB limit.
# Bootstrapped by setup.py; see the decisions log in CLAUDE.md.
3dgs-pipeline-app/tools/*
# ...except the stub assets: rc_stub / lfs_stub read them, so stub mode
# (core principle #2) must survive a fresh clone.
!3dgs-pipeline-app/tools/test_assets/

# Editor / local
*.bak
.claude/settings.local.json
