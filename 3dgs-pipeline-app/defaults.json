{
  "schema_version": 1,
  "extract": {
    "capture_preset": "orbit_drone",
    "fps_mode": "auto",
    "fps_ratio": 0.2,
    "fps_absolute": 2.0,
    "target_frame_count": 300,
    "mpdecimate": false,
    "quality": 2,
    "scale_percent": 100,
    "max_frames": 0,
    "keep_alpha": true
  },
  "curate": {
    "enabled": true,
    "auto_after_extract": true,
    "scene_detector": "adaptive",
    "cut_source": "auto",
    "min_scene_len": 15,
    "sharpness_window": 15,
    "sharpness_sensitivity": 50,
    "overlap_from_preset": true,
    "overlap_min_step_pct": 2.0,
    "overlap_band_max_pct": 12.0
  },
  "rc": {
    "feature_detection_quality": "High",
    "max_features_per_mpx": 30000,
    "max_features": 60000,
    "image_overlap": "Medium",
    "keep_largest": true,
    "merge_components": false,
    "normalise_for_lfs": true,
    "save_project": true,
    "colmap": {
      "enabled": true,
      "directory_structure": "standard",
      "file_type": "ascii",
      "exclude_unreliable_tie_points": true,
      "export_masks": false,
      "mask_extension": "mask_ext",
      "scene_rotate_x_deg": 180.0,
      "undistort": {
        "enabled": true,
        "fit": "inner_region",
        "resolution": "fit",
        "custom_width": 0,
        "custom_height": 0,
        "downscale": 1,
        "undistort_principal_point": true,
        "image_cutout": 1.0,
        "max_pixels": 0,
        "export_images": true,
        "image_format": "png",
        "pixel_format": "24-bit BGR",
        "naming_convention": "sequential",
        "background_color": "#000000"
      }
    },
    "extra_align_commands": []
  },
  "lfs": {
    "iterations": 30000,
    "strategy": "default",
    "max_gaussians": 0,
    "eval": false,
    "save_eval_images": false,
    "background_color": "#000000",
    "mask_mode": "ignore"
  },
  "export": {
    "format": "ply",
    "pattern": "{project}_{index:05d}"
  },
  "blender": {
    "scene_scale": 1.0,
    "import_mode": "splatforge"
  },
  "viewer": {
    "preview_max_points": 1000000,
    "point_size": 1.6,
    "show_cameras": true,
    "show_camera_path": true,
    "background": "#0b1220"
  }
}
