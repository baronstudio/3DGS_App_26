{
    "schema_version": 1,
    "extract": {
        "capture_preset": "orbit_drone",
        "fps_mode": "auto",
        "fps_ratio": 0.2,
        "fps_absolute": 2.0,
        "target_frame_count": 300,
        "mpdecimate": false,
        "quality": 2,
        "max_frames": 0
    },
    "curate": {
        "enabled": true,
        "auto_after_extract": true,
        "scene_detector": "adaptive",
        "min_scene_len": 15,
        "sharpness_window": 15,
        "sharpness_sensitivity": 50,
        "overlap_from_preset": true,
        "overlap_min_step_pct": 2.0,
        "overlap_band_max_pct": 12.0
    },
    "rc": {
        "precision": "Normal",
        "max_features": 60000,
        "keep_largest": true,
        "merge_components": true,
        "extra_align_commands": []
    },
    "lfs": {
        "iterations": 30000,
        "strategy": "default",
        "lr": 0.001,
        "save_interval": 0,
        "render_mode": "RGB",
        "eval": false,
        "save_eval_images": false,
        "background_color": "#000000"
    },
    "export": {
        "format": "ply",
        "pattern": "{project}_{index:05d}"
    },
    "blender": {
        "scene_scale": 1.0,
        "import_mode": "splatforge"
    }
}